# Copy to .env.cc (gitignored) and fill in. Names only here - never commit values.
# Used only by docker-compose.cc.yml (the Claude Code worker), not by production.

# LLM endpoint (OrcaRouter). No /v1 suffix: Claude Code appends /v1/messages.
ANTHROPIC_BASE_URL=
# Use AUTH_TOKEN, not ANTHROPIC_API_KEY: the latter raises an interactive
# "use this API key?" dialog that hangs an unattended TUI.
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=
ANTHROPIC_DEFAULT_HAIKU_MODEL=
ANTHROPIC_SMALL_FAST_MODEL=

# GitHub: clone, push, and `gh pr create`. Can also be passed with `run -e GH_TOKEN`.
GH_TOKEN=

# Branch the worker checks out from origin/mesh-stable (required for the Claude mode).
TASK_BRANCH=

# Commit identity inside the container.
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
GIT_COMMITTER_NAME=
GIT_COMMITTER_EMAIL=
